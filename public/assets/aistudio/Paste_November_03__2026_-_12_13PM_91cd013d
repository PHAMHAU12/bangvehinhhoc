    if(isFinite(r.hi))s+=`<circle cx="${b}" cy="${y}" r="5.5" fill="${r.hc?c:pn}" stroke="${c}" stroke-width="2"/>`;
  }
  return s+T(x,y-18,'S = '+o.e.replace(/inf/gi,'∞'),st,15);
}
const dsh=(o,round=true)=>o.ls=='dash'?'stroke-dasharray="9 7"':o.ls=='dot'?'stroke-dasharray="0.1 7"'+(round?' stroke-linecap="round"':''):'';
const arrow=(a,b,c)=>{const dx=b.x-a.x,dy=b.y-a.y,l=Math.hypot(dx,dy)||1,ux=dx/l,uy=dy/l,nx=-uy,ny=ux;
  return`<path d="M${b.x} ${b.y}L${b.x-ux*14+nx*6} ${b.y-uy*14+ny*6}L${b.x-ux*14-nx*6} ${b.y-uy*14-ny*6}Z" fill="${c}"/>`};
/* tên vectơ: chữ cái hai điểm kèm mũi tên nhỏ phía trên */
const vlab=(a,b,c)=>{
  const dx=b.x-a.x,dy=b.y-a.y,l=Math.hypot(dx,dy)||1;let nx=-dy/l,ny=dx/l;if(ny>0){nx=-nx;ny=-ny}
  const mx=(a.x+b.x)/2+nx*22,my=(a.y+b.y)/2+ny*22+5,t=a.n+b.n,w=t.length*10.5+4;
  return`<text x="${mx}" y="${my}" fill="${c}" font-size="15" font-weight="600" text-anchor="middle" stroke="${V('--bg')}" stroke-width="4" paint-order="stroke">${esc(t)}</text>`+
    `<path d="M${mx-w/2} ${my-14}H${mx+w/2}m-4 -3l4 3l-4 3" fill="none" stroke="${c}" stroke-width="1.4"/>`;
};
function draw(o,f,hl){
  const st=hl?V('--acc'):V('--ink'),w=hl?2.6:1.6,c=cc(o.c);
  switch(o.t){
    case'seg':{const a=P(o.a),b=P(o.b),sc=(!hl&&o.cl)?o.cl:st;return`<g data-id="${o.id}">${L(a.x,a.y,b.x,b.y,'transparent',16)}${L(a.x,a.y,b.x,b.y,sc,w,dsh(o))}${o.ar?arrow(a,b,sc):''}${o.vl?vlab(a,b,sc):''}</g>`}
    case'cir':{const a=P(o.c),b=P(o.r),r=Math.hypot(a.x-b.x,a.y-b.y);return`<g data-id="${o.id}"><circle cx="${a.x}" cy="${a.y}" r="${r}" fill="none" stroke="${st}" stroke-width="${w}" ${dsh(o)}/><circle cx="${a.x}" cy="${a.y}" r="${r}" fill="none" stroke="transparent" stroke-width="14"/></g>`}
    case'pb':{
      const a=P(o.a),b=P(o.b),mx=(a.x+b.x)/2,my=(a.y+b.y)/2,l=Math.hypot(b.x-a.x,b.y-a.y)||1,ux=(b.x-a.x)/l,uy=(b.y-a.y)/l,nx=-uy,ny=ux,K=3000,c2=hl?st:'#7c3aed';
      return`<g data-id="${o.id}">${L(mx-nx*K,my-ny*K,mx+nx*K,my+ny*K,'transparent',16)}${L(mx-nx*K,my-ny*K,mx+nx*K,my+ny*K,c2,w,dsh(o))}`+
        `<path d="M${mx+ux*10} ${my+uy*10}L${mx+ux*10+nx*10} ${my+uy*10+ny*10}L${mx+nx*10} ${my+ny*10}" fill="none" stroke="${c2}" stroke-width="1.2"/></g>`}
    case'pol':return`<polygon data-id="${o.id}" points="${o.ids.map(i=>P(i).x+','+P(i).y).join(' ')}" fill="${f}" stroke="${st}" stroke-width="${w}" ${dsh(o)}/>`;
    case'pen':return`<g data-id="${o.id}" transform="translate(${o.tx} ${o.ty})"><path d="${o.d}" fill="none" stroke="${hl?V('--acc'):c}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" ${dsh(o,false)}/><path d="${o.d}" fill="none" stroke="transparent" stroke-width="14"/></g>`;
    case'txt':return`<g data-id="${o.id}">${T(o.x,o.y,fmt(o.s),hl?V('--acc'):c,22)}</g>`;
    case'fn':return`<g data-id="${o.id}">${drawFn(o,st)}</g>`;
    case'pyr':return`<g data-id="${o.id}">${drawPyr(o,f,st,hl)}</g>`;
    case'pie':return`<g data-id="${o.id}">${drawPie(o,st)}</g>`;
    case'ms':{
      const col=hl?V('--acc'):'#c2410c',bg=V('--bg'),
        lab=(x,y,t)=>`<text x="${x}" y="${y}" fill="${col}" font-size="15" font-weight="600" text-anchor="middle" stroke="${bg}" stroke-width="4" paint-order="stroke" stroke-linejoin="round">${esc(t)}</text>`;
      if(o.mk=='len'){
        const a=P(o.q[0]),b=P(o.q[1]),dx=b.x-a.x,dy=b.y-a.y,l=Math.hypot(dx,dy)||1,sg=dx/l>0?-1:1,nx=-dy/l*sg,ny=dx/l*sg,s2=ny>0?-1:1;
        return`<g data-id="${o.id}">${lab((a.x+b.x)/2+nx*s2*18,(a.y+b.y)/2+ny*s2*18+5,a.n+b.n+' = '+(+(l/24).toFixed(2)))}</g>`}
      if(o.mk=='dist'){
        const p=P(o.q[0]),a=P(o.q[1]),b=P(o.q[2]),dx=b.x-a.x,dy=b.y-a.y,t=((p.x-a.x)*dx+(p.y-a.y)*dy)/(dx*dx+dy*dy||1),
          hx=a.x+t*dx,hy=a.y+t*dy,d=Math.hypot(p.x-hx,p.y-hy);
        let nx=dx,ny=dy;const nl=Math.hypot(nx,ny)||1;nx/=nl;ny/=nl;if(nx<0){nx=-nx;ny=-ny}
        return`<g data-id="${o.id}">${lab((p.x+hx)/2+nx*10,(p.y+hy)/2+ny*10-8,'d('+p.n+','+a.n+b.n+') = '+(+(d/24).toFixed(2)))}</g>`}
      if(o.mk=='area'||o.mk=='per'){
        const pts=o.q.map(P),nm=o.sh=='pol'?pts.map(p=>p.n).join(''):pts[0].n;let val,cx,cy;
        if(o.sh=='pol'){
          let A2=0,pm=0;pts.forEach((p,i)=>{const q=pts[(i+1)%pts.length];A2+=p.x*q.y-q.x*p.y;pm+=Math.hypot(q.x-p.x,q.y-p.y)});
          val=o.mk=='area'?Math.abs(A2)/2/576:pm/24;cx=pts.reduce((t,p)=>t+p.x,0)/pts.length;cy=pts.reduce((t,p)=>t+p.y,0)/pts.length}
        else{const r=Math.hypot(pts[0].x-pts[1].x,pts[0].y-pts[1].y)/24;val=o.mk=='area'?Math.PI*r*r:2*Math.PI*r;cx=pts[0].x;cy=pts[0].y}
        return`<g data-id="${o.id}">${lab(cx,cy+(o.mk=='area'?5:27),(o.mk=='area'?'S':o.sh=='pol'?'P':'C')+'('+nm+') = '+(+val.toFixed(2)))}</g>`}
      const v=P(o.q[0]),a=P(o.q[1]),b=P(o.q[2]),ux=a.x-v.x,uy=a.y-v.y,wx=b.x-v.x,wy=b.y-v.y,lu=Math.hypot(ux,uy)||1,lw=Math.hypot(wx,wy)||1,
        deg=Math.acos(Math.max(-1,Math.min(1,(ux*wx+uy*wy)/(lu*lw))))*180/Math.PI,au=[ux/lu,uy/lu],aw=[wx/lw,wy/lw];
      let mk;
      if(Math.abs(deg-90)<.05)mk=`<path d="M${v.x+au[0]*16} ${v.y+au[1]*16}L${v.x+(au[0]+aw[0])*16} ${v.y+(au[1]+aw[1])*16}L${v.x+aw[0]*16} ${v.y+aw[1]*16}" fill="none" stroke="${col}" stroke-width="1.6"/>`;
      else{const r=24,t1=Math.atan2(uy,ux),t2=Math.atan2(wy,wx),cr=ux*wy-uy*wx;
        mk=`<path d="M${v.x+r*Math.cos(t1)} ${v.y+r*Math.sin(t1)}A${r} ${r} 0 0 ${cr>0?1:0} ${v.x+r*Math.cos(t2)} ${v.y+r*Math.sin(t2)}" fill="none" stroke="${col}" stroke-width="1.8"/>`}
      let bx=au[0]+aw[0],by=au[1]+aw[1];const bl=Math.hypot(bx,by);if(bl<1e-6){bx=-au[1];by=au[0]}else{bx/=bl;by/=bl}
      return`<g data-id="${o.id}">${mk}${lab(v.x+bx*50,v.y+by*50+5,'∠'+a.n+v.n+b.n+' = '+(+deg.toFixed(1))+'°')}</g>`}
    case'tree':return`<g data-id="${o.id}">${drawTree(o,st)}</g>`;
    case'venn':return`<g data-id="${o.id}">${drawVenn(o,st)}</g>`;
    case'nl':return`<g data-id="${o.id}">${drawNL(o,st)}</g>`;
  }return'';
}
function render(noCtx){
