<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bảng Toán</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f7f8;--grid:#dfe6e9;--panel:#fff;--ink:#16262b;--mut:#5b6f77;--acc:#0f766e;--line:#d3dcdf;--pt:#2563eb;--fill:rgba(245,158,11,.22);--tip:#16262b;--tipt:#fff;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#11181b;--grid:#1f2b30;--panel:#1a2328;--ink:#e8f0f2;--mut:#8fa4ac;--acc:#2dd4bf;--line:#2c3a40;--pt:#60a5fa;--fill:rgba(245,158,11,.25);--tip:#e8f0f2;--tipt:#11181b}}
:root[data-theme=dark]{--bg:#11181b;--grid:#1f2b30;--panel:#1a2328;--ink:#e8f0f2;--mut:#8fa4ac;--acc:#2dd4bf;--line:#2c3a40;--pt:#60a5fa;--fill:rgba(245,158,11,.25);--tip:#e8f0f2;--tipt:#11181b}
html{height:100%}
body{margin:0;height:100%;display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font:14px/1.4 "Be Vietnam Pro",system-ui,sans-serif}
#bar{display:flex;gap:2px;align-items:center;overflow-x:auto;padding:6px 8px;background:var(--panel);border-bottom:1px solid var(--line)}
#bar b{margin-right:8px;font-size:15px;white-space:nowrap}
#bar .sp{flex:1}
button{font:inherit;font-size:13px;border:0;background:transparent;color:var(--ink);padding:7px 10px;border-radius:7px;cursor:pointer;white-space:nowrap}
button:hover{background:var(--grid)}button:focus-visible,input:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
button.on{background:var(--acc);color:var(--bg)}
button.dg{background:#dc2626;color:#fff}
.sw{width:20px;height:20px;padding:0;border-radius:50%;border:2px solid var(--panel);box-shadow:0 0 0 1px var(--line);margin:0 2px}
.sw.on{box-shadow:0 0 0 2px var(--acc)}
main{position:relative;flex:1;min-height:0}
svg{position:absolute;inset:0;width:100%;height:100%;touch-action:none;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px}
#ctx{position:absolute;left:50%;bottom:54px;transform:translateX(-50%);display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:center;max-width:94%;padding:6px 8px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.12)}
#ctx label{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mut)}
#ctx input[type=range]{width:110px;accent-color:var(--acc)}
#hint{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);max-width:92%;padding:6px 12px;border-radius:8px;background:var(--tip);color:var(--tipt);font-size:12.5px;text-align:center}
dialog{border:1px solid var(--line);border-radius:12px;background:var(--panel);color:var(--ink);padding:16px;width:min(420px,92vw)}
dialog::backdrop{background:rgba(0,0,0,.35)}
dialog input{width:100%;box-sizing:border-box;margin:8px 0 12px;padding:9px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--ink);font:inherit}
dialog .r{display:flex;gap:8px;justify-content:flex-end}
#zoom{position:absolute;right:10px;bottom:10px;display:flex;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.1)}
#zoom button{min-width:34px;padding:6px 8px}
.menu{position:fixed;z-index:20;display:flex;flex-direction:column;min-width:170px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 6px 22px rgba(0,0,0,.18)}
.menu button{text-align:left}
#pv{position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;background:rgba(15,23,26,.74)}
#pv .tb{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:8px 10px;background:var(--panel);border-bottom:1px solid var(--line)}
#pv .tb input[type=text]{flex:1;min-width:150px;padding:7px 9px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--ink);font:inherit}
#pv .tb label{display:flex;gap:6px;align-items:center;font-size:13px;white-space:nowrap}
#pv .pgw{flex:1;overflow:auto;padding:16px;display:flex;justify-content:center;align-items:flex-start}
#pv .pg svg{position:static;inset:auto;display:block;width:100%;height:auto;max-width:100%;background:#fff;background-image:none;box-shadow:0 6px 24px rgba(0,0,0,.4)}
@media print{
  html,body{height:auto!important;overflow:visible!important;background:#fff!important}
  body>*:not(#pv){display:none!important}
  #pv:not([hidden]){position:static;display:block!important;background:none}
  #pv .tb{display:none}
  #pv .pgw{overflow:visible;padding:0;display:block}
  #pv .pg{width:auto!important}
  #pv .pg svg{width:var(--w);height:var(--h);max-width:none;box-shadow:none}
}
#pages{display:flex;gap:4px;align-items:center;overflow-x:auto;padding:4px 8px;background:var(--bg);border-bottom:1px solid var(--line)}
#pages button{padding:4px 11px;font-size:12.5px}
#pv .sheet{margin-bottom:18px}
@media print{#pv .sheet{margin:0;break-after:page;page-break-after:always}#pv .sheet:last-child{break-after:auto;page-break-after:auto}}
[hidden]{display:none!important}
@media print{#bar,#ctx,#hint,#menu,#zoom{display:none}svg{background:none}}
</style>
</head>
<body>
<div id="bar"></div>
<div id="pages"></div>
<main>
  <svg id="c" font-family="Be Vietnam Pro,system-ui,sans-serif"></svg>
  <div id="ctx" hidden></div>
  <div id="hint"></div>
  <div id="zoom"><button data-a="zout" aria-label="Thu nhỏ">−</button><button data-a="zreset" id="zp" title="Về 100%">100%</button><button data-a="zin" aria-label="Phóng to">+</button><button data-a="zfit" title="Thu phóng để thấy hết các hình (phím F)">Vừa khung</button></div>
  <div id="menu" class="menu" hidden></div>
  <input type="file" id="fi" accept=".json,application/json" hidden>
</main>
<div id="pv" hidden>
  <div class="tb">
    <input type="text" id="pvt" placeholder="Tiêu đề bài (không bắt buộc)" autocomplete="off">
    <button data-a="pvp" class="on">Dọc</button><button data-a="pvl">Ngang</button>
    <label><input type="checkbox" id="pvg"> Kẻ ô li</label>
    <button data-a="pvpng">Tải ảnh A4 (PNG)</button><button data-a="pvprint">In / lưu PDF</button><button data-a="pvx">Đóng</button>
  </div>
  <div class="pgw"><div class="pg" id="pvpage"></div></div>
</div>
<style id="pst"></style>
<dialog id="dlg"><form method="dialog"><div id="dm"></div><input id="di" autocomplete="off"><div class="r"><button value="no" formnovalidate>Huỷ</button><button value="ok" class="on">Đồng ý</button></div></form></dialog>

<script>
const $=s=>document.querySelector(s),svg=$('#c'),dlg=$('#dlg');
const V=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const PAL=['#3b82f6','#f59e0b','#10b981','#ef4444','#8b5cf6','#06b6d4','#ec4899','#84cc16'];
const COLS=['ink','#dc2626','#2563eb','#059669'];
let O=[],H=[],tool='sel',tmp=[],sel=null,id=1,col='ink',drag=null,cur=null,er=false,tip='',vd=null,mg=null,pT,ls='solid',vw={k:1,x:0,y:0},ptrs=new Map(),pinch=null,pn=null,spaceDown=false,PG=[{name:'Trang 1',O:[],id:1,vw:{k:1,x:0,y:0},H:[]}],cp=0,pgPend=0;

/* ---------- tiện ích ---------- */
const P=i=>O.find(o=>o.id==i);
const ptsOf=o=>o.t=='seg'?[o.a,o.b]:o.t=='cir'?[o.c,o.r]:o.t=='pol'?o.ids:o.t=='pb'?[o.a,o.b]:o.t=='ms'?o.q:o.pg?o.pg:o.m?o.m:o.f?o.f:o.g?o.g:o.k?o.k:o.w?o.w:[];
const cc=c=>c=='ink'?V('--ink'):c;
const save=()=>{H.push(JSON.stringify(O));if(H.length>60)H.shift()};
function undo(){if(!H.length)return;O=JSON.parse(H.pop());tmp=[];sel=null;render()}
function nextName(pref=''){const u=new Set(O.filter(o=>o.t=='pt').map(o=>o.n));if(pref&&!u.has(pref))return pref;for(let i=0;i<26;i++){const c=String.fromCharCode(65+i);if(!u.has(c))return c}return'P'+id}
function pointAt(x,y){let p=O.find(o=>o.t=='pt'&&Math.hypot(o.x-x,o.y-y)<12/vw.k);if(!p){p={t:'pt',id:id++,x,y,n:nextName(),sh:1};O.push(p)}return p}
function del(i){
  if(!P(i))return;const r=new Set([i]);let n;
  do{n=r.size;for(const q of O)if(ptsOf(q).some(x=>r.has(x)))r.add(q.id)}while(r.size>n);
  O=O.filter(q=>!r.has(q.id));if(r.has(sel))sel=null;
}
/* điểm phụ thuộc: trung điểm (m) và chân đường cao (f) tự cập nhật khi kéo điểm gốc */
function upd(){for(const o of O){
  if(o.m){const a=P(o.m[0]),b=P(o.m[1]);o.x=(a.x+b.x)/2;o.y=(a.y+b.y)/2}
  else if(o.g){/* chân phân giác trong: chia cạnh đối diện theo tỉ lệ hai cạnh kề */
    const v=P(o.g[0]),a=P(o.g[1]),b=P(o.g[2]),d1=Math.hypot(a.x-v.x,a.y-v.y),d2=Math.hypot(b.x-v.x,b.y-v.y),k=(d1+d2)||1;
    o.x=(d2*a.x+d1*b.x)/k;o.y=(d2*a.y+d1*b.y)/k}
  else if(o.k){/* tâm đường tròn ngoại tiếp */
    const a=P(o.k[0]),b=P(o.k[1]),c=P(o.k[2]),d=2*(a.x*(b.y-c.y)+b.x*(c.y-a.y)+c.x*(a.y-b.y));
    if(Math.abs(d)>1e-6){const A=a.x*a.x+a.y*a.y,B=b.x*b.x+b.y*b.y,C=c.x*c.x+c.y*c.y;
      o.x=(A*(b.y-c.y)+B*(c.y-a.y)+C*(a.y-b.y))/d;o.y=(A*(c.x-b.x)+B*(a.x-c.x)+C*(b.x-a.x))/d}}
  else if(o.pg){const a=P(o.pg[0]),b=P(o.pg[1]),c=P(o.pg[2]);o.x=b.x+c.x-a.x;o.y=b.y+c.y-a.y}
  else if(o.w){
    const a=P(o.w[0]),b=P(o.w[1]),c=P(o.w[2]);
    if(o.wk=='G'){o.x=(a.x+b.x+c.x)/3;o.y=(a.y+b.y+c.y)/3}
    else if(o.wk=='I'){const la=Math.hypot(b.x-c.x,b.y-c.y),lb=Math.hypot(a.x-c.x,a.y-c.y),lc=Math.hypot(a.x-b.x,a.y-b.y),k=(la+lb+lc)||1;o.x=(la*a.x+lb*b.x+lc*c.x)/k;o.y=(la*a.y+lb*b.y+lc*c.y)/k}
    else{const q=ccen(a,b,c);if(q){o.x=a.x+b.x+c.x-2*q[0];o.y=a.y+b.y+c.y-2*q[1]}}}
  else if(o.f){const v=P(o.f[0]),a=P(o.f[1]),b=P(o.f[2]),dx=b.x-a.x,dy=b.y-a.y,t=((v.x-a.x)*dx+(v.y-a.y)*dy)/(dx*dx+dy*dy||1);o.x=a.x+t*dx;o.y=a.y+t*dy;o.u=t}
}}
const NEED={mid:2,alt:3,perp:2,bis:3,cc:3,gc:3,oc:3,ic:3,len:2,ang:3,vtri:3,vpg:3,dist:3},KIND={gc:'G',oc:'H',ic:'I'};
function ccen(a,b,c){
  const d=2*(a.x*(b.y-c.y)+b.x*(c.y-a.y)+c.x*(a.y-b.y));if(Math.abs(d)<1e-6)return null;
  const A=a.x*a.x+a.y*a.y,B=b.x*b.x+b.y*b.y,C=c.x*c.x+c.y*c.y;
  return[(A*(b.y-c.y)+B*(c.y-a.y)+C*(a.y-b.y))/d,(A*(c.x-b.x)+B*(a.x-c.x)+C*(b.x-a.x))/d];
}
function mk3(k,a,b,c){
  if(!ccen(P(a),P(b),P(c)))return false;
  const o={t:'pt',id:id++,x:0,y:0,n:nextName(k),sh:1,w:[a,b,c],wk:k};O.push(o);
  if(k=='I'){const T={t:'pt',id:id++,x:0,y:0,n:'T',sh:0,f:[o.id,b,c]};O.push(T);O.push({t:'cir',id:id++,c:o.id,r:T.id})}
  sel=o.id;return true;
}
function mkPerp(a,b){mkMid(a,b);const o={t:'pb',id:id++,a,b};O.push(o);sel=o.id}
/* số đo: độ dài (1 đơn vị = 1 ô lưới) và góc (độ), tự cập nhật khi kéo điểm */
function mkMs(mk,q,sh){
  const same=O.find(o=>o.t=='ms'&&o.mk==mk&&(mk=='len'?[...o.q].sort().join()==[...q].sort().join():o.q.join()==q.join()));
  if(same){sel=same.id;return}
  const o={t:'ms',id:id++,mk,q,sh};O.push(o);sel=o.id;
}
const mkLen=(a,b)=>mkMs('len',[a,b]),mkAng=(v,a,b)=>mkMs('ang',[v,a,b]);
/* cộng vectơ: vectơ tổng vẽ màu đỏ; điểm D của hình bình hành tự cập nhật khi kéo A, B, C */
function mkVec(a,b,cl){
  const d=O.find(o=>o.t=='seg'&&o.a==a&&o.b==b&&o.ar);
  if(d){if(cl)d.cl=cl;d.vl=true;return d}
  const o={t:'seg',id:id++,ls:'solid',a,b,ar:true,vl:true};if(cl)o.cl=cl;O.push(o);return o;
}
function mkVTri(a,b,c){mkVec(a,b);mkVec(b,c);sel=mkVec(a,c,'#dc2626').id}
function mkVPg(a,b,c){
  const d={t:'pt',id:id++,x:0,y:0,n:nextName('D'),sh:1,pg:[a,b,c]};O.push(d);
  mkVec(a,b);mkVec(a,c);
  O.push({t:'seg',id:id++,ls:'dash',a:b,b:d.id},{t:'seg',id:id++,ls:'dash',a:c,b:d.id});
  sel=mkVec(a,d.id,'#dc2626').id;
}
/* khoảng cách từ điểm p đến đường thẳng ab: vẽ chân đường vuông góc H và nhãn d(p,ab) */
function mkDist(p,a,b){mkAlt(p,a,b);mkMs('dist',[p,a,b])}
function mkBis(v,a,b){
  const o={t:'pt',id:id++,x:0,y:0,n:nextName('D'),sh:1,g:[v,a,b]};O.push(o);
  O.push({t:'seg',id:id++,a:v,b:o.id});sel=o.id;
}
function mkCC(a,b,c){
  const A=P(a),B=P(b),C=P(c);
  if(Math.abs(A.x*(B.y-C.y)+B.x*(C.y-A.y)+C.x*(A.y-B.y))<1e-6)return false;
  const o={t:'pt',id:id++,x:0,y:0,n:nextName('O'),sh:1,k:[a,b,c]};O.push(o);
  O.push({t:'cir',id:id++,c:o.id,r:a});sel=o.id;return true;
}
function mkMid(a,b){
  const d=O.find(o=>o.m&&((o.m[0]==a&&o.m[1]==b)||(o.m[0]==b&&o.m[1]==a)));if(d){sel=d.id;return}
  const o={t:'pt',id:id++,x:0,y:0,n:nextName('M'),sh:1,m:[a,b]};O.push(o);sel=o.id;
}
function mkAlt(v,a,b){
  const o={t:'pt',id:id++,x:0,y:0,n:nextName('H'),sh:1,f:[v,a,b]};O.push(o);
  O.push({t:'seg',id:id++,a:v,b:o.id});sel=o.id;
}
const SUP={0:'⁰',1:'¹',2:'²',3:'³',4:'⁴',5:'⁵',6:'⁶',7:'⁷',8:'⁸',9:'⁹',n:'ⁿ','-':'⁻'};
const fmt=s=>s.replace(/sqrt\(/g,'√(').replace(/\^(-?\d+|n)/g,(_,c)=>[...c].map(k=>SUP[k]||k).join('')).replace(/_(\d)/g,(_,c)=>String.fromCharCode(8320+ +c)).replace(/<=/g,'≤').replace(/>=/g,'≥').replace(/!=/g,'≠').replace(/->/g,'→').replace(/\+-/g,'±').replace(/\bpi\b/g,'π').replace(/\bdelta\b/gi,'Δ');
function cf(s){
  s=s.replace(/\^/g,'**').replace(/^\s*-/,'0-').replace(/(\d)\s*(x|m)\b/g,'$1*$2').replace(/\bln\b/g,'Math.log').replace(/\blog\b/g,'Math.log10').replace(/\b(sin|cos|tan|sqrt|abs|exp)\b/g,'Math.$1').replace(/\bpi\b/gi,'Math.PI');
  if(/[^0-9a-zA-Z.+\-*/()%, ]/.test(s))return null;
  const ok=['x','m','Math','sin','cos','tan','sqrt','abs','exp','log','log10','PI'];
  if((s.match(/[a-zA-Z_]\w*/g)||[]).some(w=>!ok.includes(w)))return null;
  try{return new Function('x','m','return '+s)}catch(e){return null}
}
function ask(m,d=''){return new Promise(r=>{$('#dm').textContent=m;const i=$('#di');i.value=d;dlg.returnValue='';dlg.showModal();i.select();dlg.onclose=()=>r(dlg.returnValue=='ok'?i.value.trim():null)})}
const msg=t=>{tip=t;hint();setTimeout(()=>{tip='';hint()},2500)};

/* ---------- vẽ ---------- */
const L=(a,b,c,d,st,w=1.6,x='')=>`<line x1="${a}" y1="${b}" x2="${c}" y2="${d}" stroke="${st}" stroke-width="${w}" ${x}/>`;
const T=(x,y,t,c,sz=14,a='start')=>`<text x="${x}" y="${y}" fill="${c}" font-size="${sz}" text-anchor="${a}">${esc(t)}</text>`;

const cr3=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]],dt3=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2],
  sb3=(a,b)=>[a[0]-b[0],a[1]-b[1],a[2]-b[2]],ad3=(a,b,t=1)=>[a[0]+t*b[0],a[1]+t*b[1],a[2]+t*b[2]],sc3=(a,k)=>a.map(x=>x*k),
  nm3=a=>sc3(a,1/(Math.hypot(...a)||1)),POOL='MNPQRKLTUVWXYZ',freeName=u=>[...POOL].find(c=>!u.has(c))||'?';
/* mô hình 3D: trục y hướng lên, đáy là đa giác đều nằm trên y = 0 */
function pyrModel(o){
  const R=o.s||90,kind=o.kind||'pyr',n=kind=='box'||kind=='fbox'?4:kind=='free'||kind=='fprism'?o.fb.length:o.n,M={},E=[],ch=i=>String.fromCharCode(65+i),base=[];
  for(let i=0;i<n;i++){
    if(kind=='box')base.push([[1,-1,-1,1][i]*R*.95,0,[1,1,-1,-1][i]*R*.6]);
    else if(kind=='free'||kind=='fprism')base.push([o.fb[i][0],0,o.fb[i][1]]);
    else if(kind=='fbox'){const q=[o.fb[0],o.fb[1],[o.fb[1][0]+o.fb[2][0]-o.fb[0][0],o.fb[1][1]+o.fb[2][1]-o.fb[0][1]],o.fb[2]];base.push([q[i][0],0,q[i][1]])}
    else{const a=i*2*Math.PI/n;base.push([R*Math.cos(a),0,R*Math.sin(a)])}
  }
  if(kind=='pyr')M.S=[0,R*1.7,0];
  if(kind=='free')M.S=[...o.fa];
  base.forEach((p,i)=>M[ch(i)]=p);
  if(kind=='pyr'||kind=='free')for(let i=0;i<n;i++)E.push(['S',ch(i)],[ch(i),ch((i+1)%n)]);
  else{
    const hh=kind=='box'?R*1.1:R*1.5,fv=(kind=='fprism'||kind=='fbox')?o.fv:[0,hh,0];
    base.forEach((p,i)=>M[ch(i)+"'"]=[p[0]+fv[0],fv[1],p[2]+fv[2]]);
    for(let i=0;i<n;i++){const j=(i+1)%n;E.push([ch(i),ch(j),'b',i],[ch(i)+"'",ch(j)+"'",'t',i],[ch(i),ch(i)+"'",'v',i])}
  }
  for(const[a,b,nm]of o.mp||[])if(M[a]&&M[b])M[nm]=sc3(ad3(M[a],M[b]),.5);
  return{R,n,M,E,kind,ch};
}
