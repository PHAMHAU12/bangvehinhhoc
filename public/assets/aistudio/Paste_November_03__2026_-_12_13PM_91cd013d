  for(const o of O){
    if(o.m){/* dấu gạch hai nửa bằng nhau */
      const a=P(o.m[0]),b=P(o.m[1]),dx=b.x-a.x,dy=b.y-a.y,l=Math.hypot(dx,dy)||1,nx=-dy/l*5,ny=dx/l*5;
      for(const k of[.25,.75]){const cx=a.x+dx*k,cy=a.y+dy*k;s+=L(cx-nx,cy-ny,cx+nx,cy+ny,ink,1.6)}}
    if(o.g){/* hai cung góc bằng nhau */
      const v=P(o.g[0]),a=P(o.g[1]),b=P(o.g[2]),r=26,
        arc=(p,q)=>{const t1=Math.atan2(p.y-v.y,p.x-v.x),t2=Math.atan2(q.y-v.y,q.x-v.x),cr=(p.x-v.x)*(q.y-v.y)-(p.y-v.y)*(q.x-v.x);
          return`<path d="M${v.x+r*Math.cos(t1)} ${v.y+r*Math.sin(t1)}A${r} ${r} 0 0 ${cr>0?1:0} ${v.x+r*Math.cos(t2)} ${v.y+r*Math.sin(t2)}" fill="none" stroke="${ink}" stroke-width="1.4"/>`};
      s+=arc(a,o)+arc(o,b)}
    if(o.w){/* đường nối đỉnh: trung tuyến (G) hoặc phân giác (I) */
      const[a,b,c]=o.w.map(P),dsh='stroke-dasharray="5 4" opacity=".6"';
      if(o.wk=='G')for(const[v,p,q]of[[a,b,c],[b,a,c],[c,a,b]])s+=L(v.x,v.y,(p.x+q.x)/2,(p.y+q.y)/2,ink,1.2,dsh);
      if(o.wk=='I')for(const v of[a,b,c])s+=L(v.x,v.y,o.x,o.y,ink,1.2,dsh)}
    if(o.f){/* ký hiệu góc vuông và phần kéo dài cạnh */
      const v=P(o.f[0]),a=P(o.f[1]),b=P(o.f[2]),e=o.u<0?a:o.u>1?b:null;
      if(e)s+=L(e.x,e.y,o.x,o.y,ink,1.2,'stroke-dasharray="5 4" opacity=".7"');
      const far=Math.hypot(a.x-o.x,a.y-o.y)>Math.hypot(b.x-o.x,b.y-o.y)?a:b,
        u=q=>{const d=Math.hypot(q.x-o.x,q.y-o.y)||1;return[(q.x-o.x)/d*10,(q.y-o.y)/d*10]},[ux,uy]=u(v),[wx,wy]=u(far);
      s+=`<path d="M${o.x+ux} ${o.y+uy}L${o.x+ux+wx} ${o.y+uy+wy}L${o.x+wx} ${o.y+wy}" fill="none" stroke="${ink}" stroke-width="1.2"/>`}
  }
  for(const o of O)if(o.t=='pt'){
    s+=`<g data-id="${o.id}"><circle cx="${o.x}" cy="${o.y}" r="14" fill="transparent"/>`+
       (o.id==sel||tmp.includes(o.id)?`<circle cx="${o.x}" cy="${o.y}" r="9" fill="none" stroke="${ac}" stroke-width="2"/>`:'')+
