    case'sph':save();o.sph=!o.sph;render();break;
    case'm3l':{
      const m=pyrModel(o),q=tok((await ask("Đo độ dài đoạn nối hai điểm (ví dụ: SA, AC', HM)",prm(o)?"AC'":'SA'))||'');
      if(q.length==2&&q[0]!=q[1]&&pt3(m,q[0])&&pt3(m,q[1])){save();o.me=[...(o.me||[]),{k:'len',a:q[0],b:q[1]}]}else if(q.length)msg('Điểm không hợp lệ');
      render();break}
    case'm3d':{
      const m=pyrModel(o),q=tok((await ask("Khoảng cách từ điểm đến mặt phẳng: nhập điểm rồi 3 điểm của mặt phẳng (ví dụ: H SAB)",prm(o)?"A' ABC":'H SAB'))||'');
      if(q.length==4&&pt3(m,q[0])&&mkPlane(m,q.slice(1))){save();o.me=[...(o.me||[]),{k:'dist',p:q[0],pl:q.slice(1)}]}else if(q.length)msg('Cần 1 điểm và 3 điểm không thẳng hàng của mặt phẳng');
      render();break}
    case'vol':save();o.vol=!o.vol;render();break;
    case'hh':save();o.hh=!o.hh;render();break;
    case'clr3':save();o.sec=null;o.gt=null;o.mp=[];o.sph=false;o.vol=false;o.hh=false;o.me=[];render();break;
    case'edit':{
      if(o.t=='txt'){const s=await ask('Sửa nội dung',o.s);if(s){save();o.s=s}}
      if(o.t=='fn'){const s=await ask('Sửa hàm số',o.e);if(s&&cf(s)){save();o.e=s}else if(s)msg('Biểu thức không hợp lệ')}
      if(o.t=='tree'){const v=nums(await ask('Sửa P(A), P(B|A), P(B|Ā)',o.p.join(', ')),3,0,1);if(v){save();o.p=v}}
      if(o.t=='venn'){const v=nums(await ask('Sửa số phần tử: chỉ A, chỉ B, A∩B, ngoài',o.v.join(', ')),4,0,1e6,true);if(v){save();o.v=v}}
      if(o.t=='nl'){const e=await ask('Sửa tập hợp',o.e);if(e&&parseSet(e)){save();o.e=e}else if(e)msg('Tập hợp không hợp lệ')}
      if(o.t=='pie'){const d=parseData(await ask('Sửa số liệu',o.d.map(a=>a.join(':')).join(', ')));if(d){save();o.d=d}}
      render();break}
  }
});
$('#ctx').addEventListener('input',e=>{
  const k=e.target.dataset.r,o=P(sel);if(!k||!o)return;
  o[k]=+e.target.value;if((o.kind=='free'||o.kind=='fprism')&&k=='n')fixFree(o);render(true);
});
$('#ctx').addEventListener('pointerdown',e=>{if(e.target.dataset.r)save()});
document.addEventListener('keyup',e=>{if(e.code=='Space'){e.preventDefault();spaceDown=false;cursor()}});
document.addEventListener('keydown',e=>{
  if(dlg.open)return;
  if(!$('#pv').hidden){if(e.key=='Escape')closePV();return}
  if(e.code=='Space'){e.preventDefault();if(!spaceDown){spaceDown=true;cursor()}return}
  if(!e.ctrlKey&&!e.metaKey&&!e.altKey){
    const r=svg.getBoundingClientRect();
    if(e.key=='+'||e.key=='='){zoomAt(1.25,r.width/2,r.height/2);return}
    if(e.key=='-'){zoomAt(.8,r.width/2,r.height/2);return}
    if(e.key=='0'){vw={k:1,x:0,y:0};applyView();return}
    if(e.key=='f'||e.key=='F'){fit();return}
    if(e.key=='PageDown'){gotoPage(cp+1);return}
    if(e.key=='PageUp'){gotoPage(cp-1);return}
  }
  if((e.ctrlKey||e.metaKey)&&e.key=='z'){e.preventDefault();undo()}
  else if((e.key=='Delete'||e.key=='Backspace')&&sel){save();del(sel);render()}
  else if(e.key=='Enter'&&tool=='pol')closePoly();
  else if(e.key=='Escape'){tmp=[];sel=null;render()}
});

/* ---------- lưu và mở bài vẽ ---------- */
/* ---------- nhiều trang: mỗi trang một bảng vẽ riêng (hình, mức phóng, lịch sử hoàn tác) ---------- */
async function pgRename(){const n=await ask('Tên trang (ví dụ: Câu 1)',PG[cp].name);if(n){PG[cp].name=n.slice(0,40);tabs();render()}}
const syncPage=()=>{const p=PG[cp];p.O=O;p.id=id;p.vw={...vw};p.H=H};
const docJSON=()=>{syncPage();return{app:'bang-toan',v:2,cur:cp,pages:PG.map(p=>({name:p.name,id:p.id,O:p.O}))}};
function tabs(){
  $('#pages').innerHTML=PG.map((p,i)=>`<button data-pg="${i}" class="${i==cp?'on':''}" title="Bấm đúp để đổi tên">${esc(p.name)}</button>`).join('')+'<button data-a="pgadd" title="Thêm trang mới">＋</button>';
}
function loadPage(i){
  cp=i;const p=PG[i];O=p.O;id=p.id;vw={...p.vw};H=p.H||(p.H=[]);sel=null;tmp=[];tabs();render();
}
function gotoPage(i){if(i<0||i>=PG.length||i==cp)return;syncPage();loadPage(i)}
function loadDoc(d){
  let pages=null,cur=0;
  if(d&&Array.isArray(d.pages)&&d.pages.length&&d.pages.every(p=>p&&Array.isArray(p.O))){pages=d.pages;cur=d.cur||0}
  else if(d&&Array.isArray(d.O))pages=[{name:'Trang 1',O:d.O,id:d.id}];
  if(!pages)return false;
  PG=pages.map((p,i)=>({name:String(p.name||'Trang '+(i+1)).slice(0,40),O:p.O,id:Math.max(p.id||1,...p.O.map(o=>o.id+1),1),vw:{k:1,x:0,y:0},H:[]}));
  loadPage(Math.min(Math.max(cur|0,0),PG.length-1));return true;
}
function persist(){try{localStorage.setItem('bangtoan:v2',JSON.stringify(docJSON()))}catch(e){}}
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000)}
function saveFile(){download(new Blob([JSON.stringify(docJSON())],{type:'application/json'}),'bai-ve.json');msg('Đã tải bài vẽ xuống (bai-ve.json)')}
$('#fi').addEventListener('change',async e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  try{if(!loadDoc(JSON.parse(await f.text())))throw 0;msg('Đã mở bài vẽ ('+PG.length+' trang)')}
  catch(_){msg('File không đúng định dạng bài vẽ')}
});
/* ---------- xem trước in A4 ---------- */
let pvPages=[],pvLand=false;
function captureAll(){/* chụp từng trang không rỗng, màu giao diện sáng, rồi trả lại đúng trạng thái đang làm việc */
  syncPage();
  const root=document.documentElement,th=root.getAttribute('data-theme'),keep={O,id,vw:{...vw},sel,tmp,H},res=[];
  root.setAttribute('data-theme','light');
  PG.forEach(p=>{
    O=p.O;id=p.id;sel=null;tmp=[];
    const bb=bbox();if(!bb)return;
    render();res.push({name:p.name,html:svg.querySelector('#vg').innerHTML,bb});
  });
  if(th===null)root.removeAttribute('data-theme');else root.setAttribute('data-theme',th);
  O=keep.O;id=keep.id;vw=keep.vw;sel=keep.sel;tmp=keep.tmp;H=keep.H;render();
  return res;
}
function pageSVG(land,title,name,grid,html,bb){
  const W=land?297:210,H=land?210:297,m=12,hdr=(title?9:0)+(name?8:0),top=m+hdr+(hdr?3:0),bot=m+6,aw=W-2*m,ah=H-top-bot,
    bw=Math.max(bb[2]-bb[0],20),bh=Math.max(bb[3]-bb[1],20),k=Math.min(aw/bw,ah/bh,.5),
    tx=m+(aw-bw*k)/2-bb[0]*k,ty=top+(ah-bh*k)/2-bb[1]*k;
  return`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}mm" height="${H}mm" style="--w:${W}mm;--h:${H}mm" font-family="Be Vietnam Pro,system-ui,sans-serif">`+
    `<rect width="${W}" height="${H}" fill="#fff"/>`+
    (grid?`<defs><pattern id="gp" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="#cbd5e1" stroke-width=".6"/></pattern></defs>`:'')+
    (title?`<text x="${W/2}" y="${m+6}" text-anchor="middle" font-size="6" font-weight="700" fill="#111">${esc(title)}</text>`:'')+
    (name?`<text x="${W/2}" y="${m+(title?9:0)+5.5}" text-anchor="middle" font-size="4.4" fill="#374151">${esc(name)}</text>`:'')+
    `<g transform="translate(${tx} ${ty}) scale(${k})">${grid?`<rect x="${bb[0]}" y="${bb[1]}" width="${bw}" height="${bh}" fill="url(#gp)"/>`:''}${html}</g>`+
    `<text x="${W-m}" y="${H-m+2}" text-anchor="end" font-size="3" fill="#6b7280">Bảng Toán · ${new Date().toLocaleDateString('vi-VN')}</text></svg>`;
}
const sheets=()=>{const t=$('#pvt').value.trim(),g=$('#pvg').checked,multi=pvPages.length>1;return pvPages.map(p=>pageSVG(pvLand,t,multi?p.name:'',g,p.html,p.bb))};
function buildPV(){
  $('#pvpage').style.width=pvLand?'min(100%,900px)':'min(100%,600px)';
  $('#pvpage').innerHTML=sheets().map(x=>`<div class="sheet">${x}</div>`).join('');
  $('#pst').textContent=`@page{size:A4 ${pvLand?'landscape':'portrait'};margin:0}`;
  $('[data-a=pvp]').classList.toggle('on',!pvLand);$('[data-a=pvl]').classList.toggle('on',pvLand);
}
function openPV(){
  const pages=captureAll();if(!pages.length){msg('Bảng đang trống, hãy vẽ gì đó trước');return}
  pvPages=pages;$('#pv').hidden=false;buildPV();
}
const closePV=()=>{$('#pv').hidden=true};
async function pvPNG(){/* mỗi trang bài tập một ảnh A4 */
  const W=pvLand?297:210,H=pvLand?210:297,sc=6,list=sheets();
  for(let i=0;i<list.length;i++){
    const str=list[i].replace(`width="${W}mm" height="${H}mm"`,`width="${W*sc}" height="${H*sc}"`);
    await new Promise(res=>{
      const img=new Image();img.onerror=res;
      img.onload=()=>{const cv=document.createElement('canvas');cv.width=W*sc;cv.height=H*sc;cv.getContext('2d').drawImage(img,0,0,W*sc,H*sc);
        cv.toBlob(async b=>{await download(b,list.length>1?`bang-toan-A4-${i+1}.png`:'bang-toan-A4.png');res()})};
      img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(str);
    });
  }
}
$('#pages').addEventListener('dblclick',e=>{const b=e.target.closest&&e.target.closest('button');if(b&&b.dataset.pg!==undefined){gotoPage(+b.dataset.pg);pgRename()}});
$('#pvt').addEventListener('input',buildPV);$('#pvg').addEventListener('change',buildPV);
/* ---------- xuất ảnh ---------- */
function png(){
  sel=null;tmp=[];render();
  const r=svg.getBoundingClientRect(),c=svg.cloneNode(true);
  c.setAttribute('width',r.width);c.setAttribute('height',r.height);c.removeAttribute('style');
  c.insertAdjacentHTML('afterbegin',`<rect width="100%" height="100%" fill="${V('--bg')}"/>`);
  const img=new Image();
  img.onload=()=>{
    const cv=document.createElement('canvas');cv.width=r.width*2;cv.height=r.height*2;
    const g=cv.getContext('2d');g.scale(2,2);g.drawImage(img,0,0);
    cv.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='bang-toan.png';a.click()});
  };
  img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(new XMLSerializer().serializeToString(c));
}

try{loadDoc(JSON.parse(localStorage.getItem('bangtoan:v2')||localStorage.getItem('bangtoan:v1')||'null'))}catch(e){}
tabs();bar();render();
matchMedia('(prefers-color-scheme:dark)').addEventListener('change',()=>render());
</script>
